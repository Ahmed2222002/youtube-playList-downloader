{
  "appId": "com.playlistdownloader.app",
  "productName": "YouTube Playlist Downloader",
  "files": ["dist-electron", "dist-react"],
  "extraResources": [
    "dist-electron/preload.cjs",
    {
      "from": "bin",
      "to": "bin",
      "filter": ["**/*"]
    }
  ],
  "icon": "./icon.ico",
  "mac": {
    "target": "dmg"
  },
  "linux": {
    "target": "AppImage",
    "category": "Utility"
  },
  "win": {
    "target": ["portable", "nsis"]
  }
}
